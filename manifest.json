{
  "manifest_version": 3,
  "name": "Smart Keysmith",
  "version": "1.1.2",
  "description": "プリセットごとにランダムなパスワードを生成して一覧表示し、ワンクリックでコピーする",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Smart Keysmith",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "description": "パスワードの一覧を開く"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
